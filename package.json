{
  "name": "remoteops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Q1 — multi-org permission console. One process: node:http API + Vite/React SPA.",
  "scripts": {
    "dev": "node --watch-path=./server --watch server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "db:reset": "rm -f app.db app.db-wal app.db-shm && npm run db:load",
    "db:load": "node scripts/load-db.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "personalisation": "node scripts/check-personalisation.js",
    "fingerprint": "node scripts/personalise.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.5"
  }
}
